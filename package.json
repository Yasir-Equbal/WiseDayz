{
  "name": "wisedayz-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "wisedayZ Windows desktop smart scheduler",
  "author": "Yasir Equbal",
  "scripts": {
    "start:api": "node server.js",
    "test": "node --check app.js && node --check server.js && node --check main.js && node tests/test-scheduler.js && node tests/test-notifications.js && node tests/test-recurring.js && node tests/test-hardening.js && node tests/test-api.js && node tests/test-postgres-config.js && node tests/test-cookie-security.js && node tests/test-ui-regressions.js && node tests/test-ai-assistant.js && node tests/test-desktop.js",
    "start:desktop": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable",
    "dist:win:publish": "electron-builder --win nsis --publish always"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "main.js",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wisedayz.desktop",
    "productName": "wisedayZ",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!data/**",
      "!dist/**",
      "!node_modules/.cache/**",
      "!.env",
      "!.env.*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/wisedayz.ico",
      "artifactName": "wisedayZ-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/wisedayz.ico",
      "uninstallerIcon": "assets/wisedayz.ico",
      "shortcutName": "wisedayZ"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Yasir-Equbal",
        "repo": "WiseDayz",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
