# Optional local API settings. The Windows desktop app configures its own local ports.
PORT=8787
DAYWISE_ALLOWED_ORIGIN=http://127.0.0.1:8000
DAYWISE_DATA_FILE=./data/daywise-db.json
# Set DATABASE_URL only if you intentionally configure a PostgreSQL server.
# DATABASE_URL=postgresql://username:password@localhost:5432/daywise
PG_POOL_MAX=10
PGSSLMODE=require
